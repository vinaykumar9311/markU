# ====================================================================
# ROYALTY REWARDS — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your Supabase & Firebase credentials
# ====================================================================

PORT=3000
APP_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
COOLDOWN_HOURS=12
QR_LIFETIME_MINUTES=5

# --------------------------------------------------------------------
# 1. SUPABASE DATABASE (https://supabase.com)
# Go to: Project Settings -> API
# --------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Use the "service_role" secret key (NOT the anon public key) for server operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (For Server-Side Phone OTP Token Verification)
# Go to: Firebase Console -> Project Settings -> Service Accounts
# Click: "Generate new private key" -> Save file as serviceAccountKey.json
# On production platforms like Render/Railway/Fly, you can paste the JSON content
# or base64 string directly into FIREBASE_SERVICE_ACCOUNT_JSON:
# --------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIG (For Phone OTP SMS in Browser)
# Go to: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Also enable: Build -> Authentication -> Sign-in method -> Phone (Enabled)
# --------------------------------------------------------------------
PUBLIC_FIREBASE_API_KEY=AIzaSy...
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
PUBLIC_FIREBASE_APP_ID=1:1234567890:web:...

# --------------------------------------------------------------------
# 4. SUBSCRIPTION BILLING & PAYMENT GATEWAY (Razorpay / Cashfree / UPI)
# --------------------------------------------------------------------
PAYMENT_LINK_MONTHLY=https://rzp.io/l/marku-monthly
PAYMENT_LINK_YEARLY=https://rzp.io/l/marku-yearly
SUPPORT_WHATSAPP_NUMBER=919311594509
UPI_ID=marku@upi
